#: app/templates/gdpr.html:238
msgid ""
"<strong>Yasal zorunluluk:</strong> Yetkili kamu kurum ve kuruluşlarının "
"usulüne uygun\n"
"                    talepleri (ör. mahkeme veya savcılık talepleri)."
msgstr ""

#: app/templates/gdpr.html:240
